---
import type { CollectionEntry } from 'astro:content';
import { categoryLabel } from '../lib/categories';
import { seriesById } from '../lib/series';

interface Props {
  video: CollectionEntry<'videos'>;
  /** alternate the duotone across a grid so the set reads as one system */
  tone?: 'indigo' | 'orange';
}

const { video, tone = 'indigo' } = Astro.props;
const { title, category, youtubeId, date, description, series, episode, badge } = video.data;

// Start at the sharpest size. Base.astro steps down automatically when a video
// has no maxres, which is common on Shorts and older uploads.
const thumb = `https://i.ytimg.com/vi/${youtubeId}/maxresdefault.jpg`;
// an episode says which show and which number; everything else says type and year
const show = seriesById(series);
const meta = show
  ? `${show.title} \u00b7 Ep ${episode}`
  : date
    ? `${categoryLabel(category)} \u00b7 ${date.getFullYear()}`
    : categoryLabel(category);
---

<button
  class="card frame frame--caption"
  type="button"
  data-video={youtubeId}
  data-title={title}
  data-description={description ?? ''}
  aria-label={`Play ${title}`}
>
  <span class="card__thumb">
    <span class={`duo duo--${tone}`} style="width:100%; aspect-ratio:16/9;">
      <img src={thumb} data-yt={youtubeId} alt="" loading="lazy" />
    </span>
    {badge && <span class="card__badge">{badge}</span>}
    <span class="card__play">
      <svg width="16" height="16" viewBox="0 0 64 64" aria-hidden="true">
        <path d="M24 18L48 32L24 46V18Z" fill="oklch(0.14 0.012 40)"></path>
      </svg>
    </span>
  </span>
  <span class="card__meta">
    <span class="card__title">{title}</span>
    <span class="card__sub">{meta}</span>
    {description && <span class="card__desc">{description}</span>}
  </span>
</button>

<style>
  /* it's a <button> so it's keyboard-operable, but it should look like a card */
  .card {
    border: 0;
    text-align: left;
    cursor: pointer;
    font: inherit;
    width: 100%;
    padding: 3.5% 3.5% 3.5% 3.5%;
  }
</style>
