---
/* The taped-photo collage. Three frames, one tape component, two duotones.
   Swap the three files in /public/collage to change the photos. Nothing
   else needs to move. */
const photos = [
  { src: '/collage/p_bust.jpg',  tone: 'indigo', top: 44,  left: 96, width: 246, rotate: -6, ratio: '4/5' },
  { src: '/collage/p_chair.jpg', tone: 'orange', top: 236, left: 276, width: 236, rotate: 5,  ratio: '4/5' },
  { src: '/collage/p_cams.jpg',  tone: 'indigo', top: 398, left: 66, width: 228, rotate: -8, ratio: '5/4' },
];
---

<div class="collage">
  <div class="collage__scaler" style="position:relative; width:620px; height:640px;">
    <div class="collage__burst"></div>
    <div class="collage__blob"></div>
    <div class="halftone" style="position:absolute; top:120px; left:392px; width:118px; height:118px; opacity:0.5; z-index:2;"></div>

    {photos.map((p, i) => (
      <div
        class="frame"
        style={`position:absolute; top:${p.top}px; left:${p.left}px; width:${p.width}px; transform:rotate(${p.rotate}deg); z-index:${5 + i};`}
      >
        <span class="tape" style={`transform:rotate(${p.rotate}deg);`}></span>
        <span class={`duo duo--${p.tone}`} style={`width:100%; aspect-ratio:${p.ratio};`}>
          <img src={p.src} alt="" />
        </span>
      </div>
    ))}

    <svg style="position:absolute; top:12px; right:34px; z-index:8;" width="44" height="44" viewBox="0 0 16 16" aria-hidden="true">
      <path d="M8 0L9.5 6.5L16 8L9.5 9.5L8 16L6.5 9.5L0 8L6.5 6.5L8 0Z" fill="var(--cream)"></path>
    </svg>
    <svg style="position:absolute; bottom:52px; right:56px; z-index:8;" width="28" height="28" viewBox="0 0 16 16" aria-hidden="true">
      <path d="M8 0L9.5 6.5L16 8L9.5 9.5L8 16L6.5 9.5L0 8L6.5 6.5L8 0Z" fill="var(--orange)"></path>
    </svg>
  </div>
</div>
