---
import '../styles/global.css';
import { CATEGORIES } from '../lib/categories';
import { SITE } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  /** highlight the current category in the nav */
  active?: string;
}

const {
  title = 'Cohan Co. Productions',
  description = 'A production company that helps creators tell their story.',
  active,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&family=Work+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <!-- ================= NAV ================= -->
    <header class="site-nav">
      <div class="site-nav__inner wrap">
        <a href="/" class="site-nav__logo" aria-label="Cohan Co. Productions, home">
          <img src="/collage/logo.png" alt="" width="46" height="46" />
          <span class="dsp">Cohan Co.</span>
        </a>
        <nav class="site-nav__links">
          {CATEGORIES.map((c) => (
            <a href={`/${c.id}`} class={active === c.id ? 'is-active' : ''}>{c.label}</a>
          ))}
          <a href="/#about">About</a>
        </nav>
        <div class="site-nav__right">
          <a href={SITE.youtube} target="_blank" rel="noopener" class="site-nav__yt" aria-label="Cohan Co. on YouTube">
            <svg width="26" height="19" viewBox="0 0 28 20" aria-hidden="true">
              <path d="M27.4 3.1A3.5 3.5 0 0 0 24.9.6C22.7 0 14 0 14 0S5.3 0 3.1.6A3.5 3.5 0 0 0 .6 3.1C0 5.3 0 10 0 10s0 4.7.6 6.9a3.5 3.5 0 0 0 2.5 2.5C5.3 20 14 20 14 20s8.7 0 10.9-.6a3.5 3.5 0 0 0 2.5-2.5C28 14.7 28 10 28 10s0-4.7-.6-6.9Z" fill="currentColor"></path>
              <path d="M11.2 14.3 18.4 10l-7.2-4.3v8.6Z" fill="var(--ink)"></path>
            </svg>
          </a>
          <a href="#contact" class="btn btn-orange btn-sm">Start a Project</a>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <!-- ================= FOOTER ================= -->
    <footer class="site-foot">
      <div class="wrap">
        <div class="site-foot__top">
          <div>
            <img src="/collage/logo.png" alt="Cohan Co. Productions" width="72" height="72" class="site-foot__mark" />
            <p class="site-foot__blurb">{SITE.tagline}</p>
          </div>
          <div class="site-foot__cols">
            <div>
              <div class="dsp site-foot__head">Work</div>
              {CATEGORIES.map((c) => <a href={`/${c.id}`}>{c.label}</a>)}
            </div>
            <div>
              <div class="dsp site-foot__head">Studio</div>
              <a href="/#about">About</a>
              <a href={SITE.youtube} target="_blank" rel="noopener">YouTube</a>
              <a href={`mailto:${SITE.email}`}>Contact</a>
            </div>
          </div>
        </div>
        <div class="site-foot__legal">&copy; {new Date().getFullYear()} Cohan Co. Productions</div>
      </div>
    </footer>

    <!-- ================= VIDEO LIGHTBOX ================= -->
    <div class="lightbox" id="lightbox" data-open="false" role="dialog" aria-modal="true" aria-label="Video player">
      <div class="lightbox__inner">
        <div class="lightbox__bar">
          <span class="lightbox__title" id="lightbox-title"></span>
          <button type="button" class="lightbox__close" id="lightbox-close">Close</button>
        </div>
        <div class="lightbox__frame" id="lightbox-frame"></div>
      </div>
    </div>

    <script is:inline>
      (function () {
        var box = document.getElementById('lightbox');
        var frame = document.getElementById('lightbox-frame');
        var titleEl = document.getElementById('lightbox-title');

        function open(id, title) {
          titleEl.textContent = title || '';
          frame.innerHTML =
            '<iframe src="https://www.youtube-nocookie.com/embed/' +
            encodeURIComponent(id) +
            '?autoplay=1&rel=0" title="' +
            (title || 'Video').replace(/"/g, '&quot;') +
            '" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>';
          box.setAttribute('data-open', 'true');
          document.body.style.overflow = 'hidden';
        }

        function close() {
          box.setAttribute('data-open', 'false');
          frame.innerHTML = ''; // unmounting the iframe stops playback
          document.body.style.overflow = '';
        }

        document.addEventListener('click', function (e) {
          var card = e.target.closest('[data-video]');
          if (card) {
            open(card.getAttribute('data-video'), card.getAttribute('data-title'));
            return;
          }
          if (e.target === box || e.target.id === 'lightbox-close') close();
        });

        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape') close();
        });
      })();
    </script>

    <style>
      .site-nav { border-bottom: 1px solid var(--ink3); }
      .site-nav__inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        padding-top: 26px;
        padding-bottom: 26px;
      }
      .site-nav__logo { display: flex; align-items: center; gap: 11px; }
      .site-nav__logo img { display: block; width: 46px; height: 46px; }
      .site-nav__logo span { font-weight: 800; font-size: 21px; }
      .site-nav__right { display: flex; align-items: center; gap: 18px; }
      .site-nav__yt { color: var(--cream); display: flex; }
      .site-nav__yt:hover { color: var(--orange); }
      .site-nav__links { display: flex; gap: 34px; font-size: 15px; font-weight: 500; color: var(--muted); }
      .site-nav__links a:hover { color: var(--cream); }
      .site-nav__links .is-active {
        color: var(--cream);
        border-bottom: 2px solid var(--orange);
        padding-bottom: 3px;
      }

      .site-foot { border-top: 1px solid var(--ink3); padding: 48px 0; }
      .site-foot__top { display: flex; align-items: flex-start; justify-content: space-between; gap: 40px; }
      .site-foot__mark { display: block; width: 72px; height: 72px; margin-bottom: 14px; }
      .site-foot__blurb { font-size: 14px; color: var(--muted); max-width: 250px; line-height: 1.6; margin: 0; }
      .site-foot__cols { display: flex; gap: 72px; }
      .site-foot__cols > div { display: flex; flex-direction: column; gap: 9px; font-size: 14px; color: var(--muted); }
      .site-foot__cols a:hover { color: var(--cream); }
      .site-foot__head { font-weight: 700; font-size: 14px; color: var(--cream); margin-bottom: 5px; }
      .site-foot__legal {
        margin-top: 36px;
        padding-top: 24px;
        border-top: 1px solid var(--ink2);
        font-size: 13px;
        color: oklch(0.52 0.012 40);
      }

      @media (max-width: 720px) {
        .site-nav__links { display: none; }
        .site-nav__logo img { width: 38px; height: 38px; }
        .site-nav__logo span { font-size: 18px; }
        .site-foot__top { flex-direction: column; gap: 28px; }
        .site-foot__cols { gap: 56px; }
      }
    </style>
  </body>
</html>
