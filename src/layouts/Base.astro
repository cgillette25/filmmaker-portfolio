---
interface Props {
  title?: string;
}
const { title = 'Filmmaker Portfolio' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body>
    <nav>
      <a href="/">Home</a>
      <a href="/verticals">Verticals</a>
      <a href="/shorts">Shorts</a>
      <a href="/dance">Dance</a>
    </nav>
    <main>
      <slot />
    </main>
  </body>
</html>
